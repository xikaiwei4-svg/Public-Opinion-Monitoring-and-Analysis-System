# ===========================================================
# frontend/.env.production.example — 前端生产环境配置模板
# ===========================================================
# 在 Vite 构建时（npm run build），此处变量会替换 import.meta.env 的值
#
# VITE_API_BASE_URL:
#   Docker          → /api（Nginx 代理到 backend:8000）
#   独立部署前端     → 留空（同源请求）
#   前后端分离部署   → https://api.yourdomain.com（后端完整地址）
# ===========================================================

VITE_API_BASE_URL=/api
