# ===========================================================
# backend/.env.production — 生产环境配置模板
# ===========================================================
# 使用方法：
#   1. 复制为 .env（部署时不要提交到 git）
#   2. 将所有 PLACEHOLDER_CHANGE_ME 替换为实际值
#   3. 密码生成: openssl rand -base64 16
#   4. 密钥生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ===========================================================

# ── MySQL 数据库配置 ──
MYSQL_HOST=localhost          # MySQL 主机地址（Docker 部署时填 mysql）
MYSQL_PORT=3306               # MySQL 端口
MYSQL_USER=root               # MySQL 用户名
MYSQL_PASSWORD=PLACEHOLDER_CHANGE_ME   # 【必填】16位以上强密码
MYSQL_DATABASE=campus_opinion # 数据库名

# ── JWT 密钥 ──
# 【必填】使用下列命令生成:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# 或: openssl rand -base64 32
SECRET_KEY=PLACEHOLDER_CHANGE_ME

# ── 生产环境标记 ──
DEBUG=False
ENVIRONMENT=production

# ── CORS 允许的来源域名（逗号分隔）──
# 多个域名: http://localhost:3000,https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# ── Redis 配置 ──
# Docker 部署时填 redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0
