# ============================================================
# .env.example — 校园舆情系统 环境变量模板
# 复制为 .env，填写实际值后使用
# ============================================================
# 密钥生成:
#   SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#   MYSQL_PASSWORD: 16位+大小写数字符号，如 K8mNxP2qR5vY9wZa#1
# ============================================================

# ── MySQL 数据库 ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_16PLUS
MYSQL_DATABASE=campus_opinion

# ── JWT 签名密钥（生产必改）──
SECRET_KEY=CHANGE_ME_python3_-c_import_secrets_print_secrets_token_urlsafe_32

# ── 运行时配置 ──
DEBUG=False
ENVIRONMENT=production

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── CORS 允许的来源域名（逗号分隔）──
# 生产环境: https://yourdomain.com,https://api.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ── Docker Compose 专属（部署时自动设置）──
# 这些值由 docker-compose.yml 中的 environment 块覆盖，
# 或由 deploy.yml 中的 GitHub Secrets → 临时 .env 提供。

# 容器内 MySQL 主机名（Docker 网络中用服务名）
# MYSQL_HOST=mysql
# 容器内 Redis 主机名
# REDIS_URL=redis://redis:6379/0
